# DecisionVault — environment configuration example
# Copy values into backend/DecisionVault.API/appsettings.{Environment}.json
# (or set as environment variables using the __ separator, e.g. Jwt__Secret).

# ---- ConnectionStrings:DecisionVault ----
DV_DB_HOST=localhost
DV_DB_PORT=5433
DV_DB_NAME=decisionvault
DV_DB_USER=postgres
DV_DB_PASSWORD=decisionvault_dev

# ---- Jwt ----
DV_JWT_ISSUER=DecisionVault.API
DV_JWT_AUDIENCE=DecisionVault.Client
# Production: inject via secret store; NEVER commit real secrets.
DV_JWT_SECRET=change-me-min-32-characters-long!!
DV_JWT_EXPIRY_MINUTES=120

# ---- Seeding ----
# true → creates demo accounts (demo@example.com/Demo#12345, admin@example.com/Admin#12345)
# and 5 sample decisions with options/reasons/events on first run.
DV_SEED_DEMO_DATA=true

# ---- Frontend (frontend/decision-vault/src/environments/environment.ts) ----
DV_API_BASE_URL=http://localhost:5000/api

# ---- CORS (Program.cs) ----
DV_CORS_ORIGINS=http://localhost:4200
